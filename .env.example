# Copia este archivo a .env y rellena la clave. .env NUNCA se commitea:
# el repositorio es publico.
FISH_API_KEY=sk-fish-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave publica del sitio lolesports.com (la manda su propia pagina en el
# header x-api-key). La usa tools/partidos.mjs para el calendario.
LOLESPORTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Carpeta con pistas de stock con licencia de uso: fuera del repo (ver tools/audio/CREDITOS.md)
MUSICA_DIR=/ruta/a/tu/carpeta/de/musica
